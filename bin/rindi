#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# rindi - Apple Silicon Standalone Native C++ ANE + Metal GPU Inference Server

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Ensure native server binary is compiled
if [ ! -f "$ROOT_DIR/runtime/rindi-server" ]; then
  echo "[Rindi] Compiling native Apple Silicon ANE + Metal GPU server..."
  make -C "$ROOT_DIR" || exit 1
fi

# Launch Native C++ Inference Server
exec "$ROOT_DIR/runtime/rindi-server" "$@"
